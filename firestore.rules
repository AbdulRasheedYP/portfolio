rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Public Content: Anyone can read; only authenticated admin can create, update, or delete
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /skills/{skillId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /socials/{socialId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Contact Messages: Public can ONLY create (submit contact form); reading and deleting is strictly restricted to authenticated admin
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
